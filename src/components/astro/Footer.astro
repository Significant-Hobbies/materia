---
import { site } from '@/data/site';

const year = new Date().getFullYear();
const cols = [
  {
    title: 'Explore',
    links: [
      { label: 'Body explorer', href: '/' },
      { label: 'Conditions', href: '/conditions' },
      { label: 'Remedies', href: '/remedies' },
      { label: 'Compounds', href: '/compounds' },
    ],
  },
  {
    title: 'About',
    links: [
      { label: 'Methodology', href: '/methodology' },
      { label: 'About Materia', href: '/about' },
      { label: 'FAQ', href: '/faq' },
      { label: 'Disclaimer', href: '/disclaimer' },
    ],
  },
];
---

<footer class="mt-24 border-t border-line bg-surface-2/40">
  <div class="container-x grid gap-10 py-12 sm:grid-cols-[1.5fr_1fr_1fr]">
    <div class="max-w-xs">
      <div class="flex items-center gap-2">
        <span
          class="grid h-6 w-6 place-items-center rounded bg-accent text-[13px] font-semibold text-white"
          style="font-family: var(--font-display)">M</span
        >
        <span class="font-medium text-ink" style="font-family: var(--font-display)">Materia</span>
      </div>
      <p class="mt-3 text-sm text-muted">{site.tagline}</p>
      <p class="mt-3 text-[12.5px] leading-relaxed text-faint">
        Ad-free. We don’t sell supplements. Every claim is graded and cited.
      </p>
    </div>
    {
      cols.map((col) => (
        <div>
          <h3 class="eyebrow mb-3">{col.title}</h3>
          <ul class="space-y-2">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-muted transition-colors hover:text-ink">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="border-t border-line">
    <div class="container-x flex flex-wrap items-end justify-between gap-4 py-4 text-[12px] text-faint">
      <div class="grid gap-1">
        <p>© {year} {site.name}. Educational reference only, not medical advice.</p>
        <p>Microsoft Clarity measures public reference navigation; search and checker routes are excluded.</p>
      </div>
      <a
        href="https://github.com/Significant-Hobbies/materia"
        aria-label="GitHub repository"
        title="GitHub repository"
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 text-faint transition-colors hover:text-ink"
      >
        <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</footer>
